{
  "name": "zhijuan",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "智卷 · 在线测评系统（管理员端 + 教师端 + 学生端）",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "template": "python scripts/make_template.py",
    "import:test": "tsx scripts/test-import.ts",
    "e2e:paper": "node scripts/e2e-real-paper.mjs",
    "visual:paper": "node scripts/visual-check-real-paper.mjs",
    "demo:data": "node scripts/seed-demo.mjs",
    "demo:reset": "node scripts/seed-demo.mjs --force",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "antd": "^6.7.2",
    "echarts": "^6.1.0",
    "fastify": "^5.12.8",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sanitize-html": "^2.18.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
